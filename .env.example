# Contraseña para la base de datos PostgreSQL
PG_PASS=GeneraUnaContrasenaSeguraAqui

# Clave secreta para Authentik (puedes generar una con: openssl rand -base64 36)
AUTHENTIK_SECRET_KEY=GeneraOtraClaveAleatoriaYLargaAqui

# Habilitar el envío de informes de error anónimos a Authentik (true/false)
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Versión de Authentik (latest para descargar siempre la última versión)
AUTHENTIK_TAG=2024.12.0

# Puerto donde se expondrá la interfaz web HTTP
AUTHENTIK_PORT_HTTP=9000
# Puerto HTTPS (si vas a manejar SSL directamente en Authentik en lugar de un Reverse Proxy)
AUTHENTIK_PORT_HTTPS=9443